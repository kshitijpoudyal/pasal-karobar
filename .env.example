# Public environment variables (safe for the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: daily mock transactions (npm run seed:daily)
SEED_BUSINESS_ID=11111111-1111-1111-1111-111111111111
# SEED_INCOME_COUNT=42
# SEED_EXPENSE_COUNT=3
# SEED_TIMEZONE=Asia/Kathmandu
